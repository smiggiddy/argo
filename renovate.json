{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices", ":dependencyDashboard"],
  "prConcurrentLimit": 10,
  "hostRules": [{ "concurrentRequestLimit": 5 }],
  "packageRules": [
    {
      "matchUpdateTypes": ["patch"],
      "matchCurrentVersion": "!/^0/",
      "automerge": true
    },
    {
      "groupName": "all digest updates",
      "groupSlug": "all-digest",
      "matchPackageNames": ["*"],
      "matchUpdateTypes": ["digest"]
    },
    {
      "description": "Keep hermes-agent out of the all-digest group so its diff is reviewable on its own",
      "matchPackageNames": ["nousresearch/hermes-agent"],
      "groupName": "hermes-agent",
      "groupSlug": "hermes-agent"
    },
    {
      "description": "opengym api and web are released together: one PR for both",
      "matchPackageNames": ["ghcr.io/duartesantos8/opengym-api", "ghcr.io/duartesantos8/opengym-web"],
      "groupName": "opengym",
      "groupSlug": "opengym"
    },
    {
      "description": "webhook_relay is a small worker: one PR for its non-major npm updates",
      "matchFileNames": ["webhook_relay/**"],
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "webhook-relay",
      "groupSlug": "webhook-relay"
    },
    {
      "description": "VictoriaMetrics and VictoriaLogs charts come from the same repo and usually release together",
      "matchPackageNames": ["victoria-metrics-k8s-stack", "victoria-logs-single"],
      "groupName": "victoriametrics",
      "groupSlug": "victoriametrics"
    },
    {
      "description": "Argo CD chart plus the tools its repo-server sidecars download: one repo-server rollout",
      "matchPackageNames": [
        "argo-cd",
        "argoproj-labs/argocd-vault-plugin",
        "helm/helm",
        "kubernetes-sigs/kustomize"
      ],
      "groupName": "argocd"
    },
    {
      "description": "Pin each CNPG ClusterImageCatalog entry to its own postgres major. Every Cluster declares the major in its imageCatalogRef, so crossing it here breaks the ref -- and on CNPG 1.26+ a major image change triggers an automatic offline pg_upgrade.",
      "matchFileNames": ["kubernetes/kustomizations/cnpg-databases/*image-catalog.yaml"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "OpenCloud rolling releases can carry breaking changes: review every bump",
      "matchPackageNames": ["opencloudeu/opencloud-rolling"],
      "automerge": false
    },
    {
      "description": "cloudnative-vectorchord tags encode the postgres major.minor as well as the extension version, and immich only accepts vchord >=0.3 <2. Never automerge it.",
      "matchPackageNames": ["ghcr.io/tensorchord/cloudnative-vectorchord"],
      "automerge": false
    },
    {
      "description": "Argo syncs the system-upgrade Plans, so merging a k3s bump upgrades the nodes. Never automerge it.",
      "matchPackageNames": ["k3s"],
      "automerge": false
    },
    {
      "description": "Immich runs DB schema migrations on upgrade: keep server and ML in one PR, never automerge",
      "matchPackageNames": [
        "ghcr.io/immich-app/immich-server",
        "ghcr.io/immich-app/immich-machine-learning"
      ],
      "groupName": "immich",
      "groupSlug": "immich",
      "automerge": false
    },
    {
      "description": "Bare image names whose tag is set elsewhere (kustomize images:, the Mattermost CR version, or a k3s Plan's version). Don't pin digests onto the base reference.",
      "matchManagers": ["kubernetes"],
      "matchPackageNames": [
        "nousresearch/hermes-agent",
        "ghcr.io/plastic-labs/honcho",
        "ghcr.io/umami-software/umami",
        "docker.io/miniflux/miniflux",
        "ghcr.io/home-assistant/home-assistant",
        "ghcr.io/duartesantos8/opengym-api",
        "ghcr.io/duartesantos8/opengym-web",
        "valkey/valkey",
        "searxng/searxng",
        "itzcrazykns1337/vane",
        "cr.smigz.com/the-method",
        "cr.smigz.com/mattermost-te",
        "rancher/k3s-upgrade"
      ],
      "enabled": false
    }
  ],
  "argocd": {
    "managerFilePatterns": ["/^awx/.+\\.yaml$/", "/^kubernetes/argocd\\.yaml$/"]
  },
  "helm-values": {
    "managerFilePatterns": ["/^kubernetes/helm/.+/values\\.ya?ml$/", "/^kubernetes/argocd/values\\.ya?ml$/"]
  },
  "kustomize": {
    "managerFilePatterns": ["/(^|/)kustomization\\.ya?ml$/"],
    "pinDigests": false
  },
  "kubernetes": {
    "managerFilePatterns": ["/^kubernetes/kustomizations/.+\\.ya?ml$/", "/^argo-workflows/.+\\.ya?ml$/"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Chart versions in helm ApplicationSet app.yaml files",
      "managerFilePatterns": ["/^kubernetes/helm/.+/app\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: registryUrl=(?<registryUrl>\\S+))?\\n\\s*version: (?<currentValue>\\S+)"
      ]
    },
    {
      "customType": "regex",
      "description": "Tool versions the argocd repo-server downloads for the vault plugin sidecars",
      "managerFilePatterns": ["/^kubernetes/argocd/values\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) extractVersion=(?<extractVersion>\\S+)\\n\\s*- name: \\S+\\n\\s*value: \"?(?<currentValue>[^\"\\s]+)\"?"
      ]
    },
    {
      "customType": "regex",
      "description": "k3s version in system-upgrade-controller Plans",
      "managerFilePatterns": ["/^kubernetes/kustomizations/system-upgrade/(agent|control-plane)\\.yaml$/"],
      "matchStrings": ["version: (?<currentValue>\\S+)"],
      "depNameTemplate": "k3s",
      "versioningTemplate": "semver-coerced",
      "datasourceTemplate": "custom.k3s"
    },
    {
      "customType": "regex",
      "description": "GitHub release URLs in kustomizations",
      "managerFilePatterns": [
        "/^kubernetes/kustomizations/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "https://github\\.com/(?<depName>[^/]+/[^/]+)/releases/download/(?<currentValue>v?[^/]+)/"
      ],
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Mattermost Team Edition version in Argo Workflows",
      "managerFilePatterns": [
        "/^argo-workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\s*- name: mm-version\\n\\s*value: \"(?<currentValue>[^\"]+)\""
      ],
      "versioningTemplate": "semver-coerced"
    },
    {
      "customType": "regex",
      "description": "Mattermost base image tag and ARM64 digest",
      "managerFilePatterns": [
        "/^argo-workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=docker depName=(?<depName>\\S+)\\n\\s*- name: base-image-tag\\n\\s*value: \"(?<currentValue>[^\"]+)\"\\n\\s*- name: base-image-arm64-digest\\n\\s*value: \"(?<currentDigest>sha256:[a-f0-9]+)\""
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Mattermost Team Edition version in GitHub Actions",
      "managerFilePatterns": [
        "/^\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\s*MM_VERSION: \"(?<currentValue>[^\"]+)\""
      ],
      "versioningTemplate": "semver-coerced"
    },
    {
      "customType": "regex",
      "description": "Mattermost base image tag and ARM64 digest in GitHub Actions",
      "managerFilePatterns": [
        "/^\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=docker depName=(?<depName>\\S+)\\n\\s*BASE_IMAGE_TAG: \"(?<currentValue>[^\"]+)\"\\n\\s*BASE_IMAGE_ARM64_DIGEST: \"(?<currentDigest>sha256:[a-f0-9]+)\""
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Mattermost Team Edition version deployed by the Mattermost operator. Releases are tagged vX.Y.Z, the CR wants X.Y.Z.",
      "managerFilePatterns": [
        "/^kubernetes/kustomizations/mattermost/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\s*version: (?<currentValue>\\S+)"
      ],
      "extractVersionTemplate": "^v(?<version>.+)$",
      "versioningTemplate": "semver-coerced"
    }
  ],
  "customDatasources": {
    "k3s": {
      "defaultRegistryUrlTemplate": "https://update.k3s.io/v1-release/channels",
      "transformTemplates": [
        "{\"releases\":[{\"version\": $$.(data[id = 'stable'].latest),\"sourceUrl\":\"https://github.com/k3s-io/k3s\",\"changelogUrl\":$join([\"https://github.com/k3s-io/k3s/releases/tag/\",data[id = 'stable'].latest])}],\"sourceUrl\": \"https://github.com/k3s-io/k3s\",\"homepage\": \"https://k3s.io/\"}"
      ]
    }
  }
}
