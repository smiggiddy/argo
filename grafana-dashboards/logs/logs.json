          },
          "editorMode": "code",
          "expr": "hostname:in($hostname) unit:in($unit) _msg:~\"(?i)$search\" | stats by (unit) count() logs",
          "queryType": "statsRange",
          "refId": "A",
          "legendFormat": "{{unit}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 0,
