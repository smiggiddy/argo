      }
    },
    {
      "id": 6,
      "type": "logs",
      "title": "Access (ssh / sudo)",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "editorMode": "code",
          "expr": "hostname:in($hostname) unit:in(\"sshd\",\"sshd-session\",\"sudo\")",
          "queryType": "instant",
          "refId": "A",
          "maxLines": 1000
