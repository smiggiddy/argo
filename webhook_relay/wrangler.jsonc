{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "argocd_webhook_relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-16",
  "upload_source_maps": true,
  "vars": {
    "ARGOCD_WEBHOOK_URL": "http://argocd-server.argocd.svc.cluster.local/api/webhook",
    "ARGOCD_APPSET_WEBHOOK_URL": "http://argocd-applicationset-controller.argocd.svc.cluster.local:7000/api/webhook",
  },
  "routes": [
    {
      "pattern": "acd-hook.smig.tech",
      "custom_domain": true,
    },
  ],
  "vpc_services": [
    {
      "binding": "VPC_SERVICE",
      "service_id": "01a14777-9090-72f3-9ada-b2e895672086",
    },
    {
      "binding": "VPC_APPSET_SERVICE",
      "service_id": "01a199f2-5368-7402-91ec-f054c79439cc",
    },
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
  },
}
