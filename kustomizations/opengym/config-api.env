# Non-secret API configuration, generated into the opengym-api-config ConfigMap.
# Passkeys are bound to the exact hostname, so RP_ID and ORIGIN must match the
# Ingress host (https). Everything else from the project's .env.example can be
# added here; secrets do not belong in this file.
PORT=3000
DATA_DIR=/data
RP_NAME=openGym
RP_ID=opengym.lab.smig.tech
ORIGIN=https://opengym.lab.smig.tech
ADMIN_UIDS=1
