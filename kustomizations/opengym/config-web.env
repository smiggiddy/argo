# Non-secret web (nginx) configuration, generated into the opengym-web-config
# ConfigMap. The api is a separate pod now, so BACKEND is its Service name rather
# than 127.0.0.1 and nginx needs a resolver to look it up on every /api request.
NGINX_PORT=80
BACKEND=opengym-api.opengym.svc.cluster.local
PORT=3000
# kube-dns FQDN; nginx resolves it at start-up via the pod's own /etc/resolv.conf.
RESOLVER=kube-dns.kube-system.svc.cluster.local
